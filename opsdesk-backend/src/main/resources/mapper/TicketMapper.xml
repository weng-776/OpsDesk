<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  工单 Mapper XML（工单 D4-01）

  规格依据：规格基线 §7.4（状态流转实现约束）

  ⚠️ 为什么这条 UPDATE 必须写在 XML，而不是用 updateById：
    §7.4 的 SQL 是「乐观锁 + 状态前置条件」双条件 —— `WHERE status = #{from} AND version = #{version}`。
    实体上的 @Version 只让 MP 追加 version 条件，**不会带 status**。
    少了 status 就漏掉一类并发：A 把工单从 ASSIGNED 推到 IN_PROGRESS 之后，
    B 若拿着相同 version 到达，仍会在「已经不是 ASSIGNED」的状态上强行流转。
    带 status 条件才能保证「我看到的状态到现在没变过」。

    而且这是自定义 SQL，按 SOP §5 红区必须走 XML，不用 wrapper.apply("raw sql")。

  ⚠️ 参数一律 #{}，绝不用 ${}（${} 是字符串拼接 = SQL 注入入口）。
-->

<mapper namespace="com.opsdesk.ticket.mapper.TicketMapper">

    <!--
      CAS 的 WHERE 条件 —— 抽成片段供所有状态流转共用。
      条件四件套缺一不可：
        id      定位行
        status  保证「我看到的状态到现在没变过」
        version 乐观锁
        deleted 逻辑删除（绕过 MP 的 @TableLogic 手写 SQL 时必须自己带）
      ⚠️ 抽片段是为了让 D4-04/05 新增流转时**不可能漏掉其中一条** ——
         复制粘贴的 WHERE 迟早会漂移。
    -->
    <sql id="casWhere">
        WHERE id = #{id}
          AND status = #{from}
          AND version = #{version}
          AND deleted = 0
    </sql>

    <!--
      状态流转 CAS 更新（工单 D4-01）。

      影响行数为 0 = CAS 失败（status 或 version 与期望不符），
      调用方 TicketFlowServiceImpl 据此抛 40900（§25.4 用例 #2「两人同时 accept」）。

      assignee_id / first_response_at 用 <if> 做「可选的列更新」：
        · assign / accept 需要改 assignee_id；start / transfer 不需要（传 null → 跳过）
        · first_response_at 只在「为空」时才由 Java 侧传值（§9.3 首次响应）；
          已响应过则传 null → 跳过 → 保留首轮值（§9.6「不重置」）

      注意 SET 子句里逗号的写法：先写不带逗号的两项，可选列各自以「逗号开头」追加，
      这样无论哪几个可选列生效，语法都成立。
    -->
    <update id="updateStatusCas">
        UPDATE ticket
        SET status = #{to},
            version = version + 1
        <if test="assigneeId != null">, assignee_id = #{assigneeId}</if>
        <if test="firstResponseAt != null">, first_response_at = #{firstResponseAt}</if>
        <include refid="casWhere"/>
    </update>

    <!--
      带附加列的状态流转 CAS（工单 D4-03 引入，D4-04 扩展）。

      覆盖三种流转：
        · hold    ：sla_paused_at = now
        · resume  ：清空 sla_paused_at + 顺延 resolution_deadline + 累加 sla_paused_minutes
        · resolve ：sla_paused_at = now + resolved_at = now
        · close   ：同 resume 的 SLA 恢复 + closed_at = now
        · reject  ：清空暂停 + 新一轮 resolution_deadline + 重置 SLA 状态/标志位 + reopen_count++
        · cancel  ：cancel_reason = 撤销原因

      附加列全部走 TicketStatePatch（null = 不写，保持原值）。
      ⚠️ clearSlaPausedAt 是必需的：<if test="x != null"> 表达不了「置 NULL」。
      ⚠️ 这里**故意没有 response_deadline** —— §9.4 明确「响应时限不参与顺延」，
         不写它就不可能在改 SLA 时误伤它（结构性保证）。
      ⚠️ 用 <include refid="casWhere"/> 与上面的 updateStatusCas 共用同一份 CAS 条件。
    -->
    <update id="updateStatusCasExtended">
        UPDATE ticket
        SET status = #{to},
            version = version + 1
        <if test="patch.assigneeId != null">, assignee_id = #{patch.assigneeId}</if>
        <if test="patch.firstResponseAt != null">, first_response_at = #{patch.firstResponseAt}</if>
        <if test="patch.slaPausedAt != null">, sla_paused_at = #{patch.slaPausedAt}</if>
        <if test="patch.clearSlaPausedAt">, sla_paused_at = NULL</if>
        <if test="patch.resolutionDeadline != null">, resolution_deadline = #{patch.resolutionDeadline}</if>
        <if test="patch.slaPausedMinutes != null">, sla_paused_minutes = #{patch.slaPausedMinutes}</if>
        <if test="patch.resolvedAt != null">, resolved_at = #{patch.resolvedAt}</if>
        <if test="patch.closedAt != null">, closed_at = #{patch.closedAt}</if>
        <if test="patch.reopenCount != null">, reopen_count = #{patch.reopenCount}</if>
        <if test="patch.slaResolutionState != null">, sla_resolution_state = #{patch.slaResolutionState}</if>
        <if test="patch.slaWarningNotified != null">, sla_warning_notified = #{patch.slaWarningNotified}</if>
        <if test="patch.slaBreachNotified != null">, sla_breach_notified = #{patch.slaBreachNotified}</if>
        <if test="patch.cancelReason != null">, cancel_reason = #{patch.cancelReason}</if>
        <include refid="casWhere"/>
    </update>

    <!--
      SLA 定时扫描的结果回写（工单 D5-03，规格基线 §9.5）。

      ⚠️ 这条 UPDATE **故意不 include casWhere** —— 它与状态流转是两种语义：
        · 流转：改状态 + 乐观锁（status + version 双条件，0 行 = 40900）
        · 扫描：只刷新派生数据（SLA 状态），**不改 status、不 bump version**
          扫描若 bump version，每 5 分钟就会让所有未关闭工单的 version 前进，
          用户此时提交的流转会莫名 CAS 失败 → 40900。
          SLA 状态丢一次竞争无害（5 分钟后自然纠正），不值得引入冲突。

      ⚠️ WHERE 只有 id + deleted：
        手写 SQL 绕过了 MP 的 @TableLogic，deleted = 0 必须自己带。

      ⚠️ 两个标志位用 <if> 条件追加列，所以**只置 1、绝不清 0**。
        清零只发生在 §9.6 的 reopen（见 updateStatusCasExtended）。
        若扫描会清零，状态在 WARNING/NORMAL 之间抖动时就会反复轰炸通知。
    -->
    <update id="updateSlaScan">
        UPDATE ticket
        SET sla_response_state = #{responseState},
            sla_resolution_state = #{resolutionState}
        <if test="warningNotified">, sla_warning_notified = 1</if>
        <if test="breachNotified">, sla_breach_notified = 1</if>
        WHERE id = #{id}
          AND deleted = 0
    </update>

</mapper>
